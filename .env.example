# Run npm run setup to detect your own OpenClaw installation.
OPENCLAW_GATEWAY_URL=http://localhost:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_WORKSPACE_PATH=
CLAWDIFY_SESSION_SECRET=
CLAWDIFY_PIN=
PORT=3000
# Optional comma-separated hostnames for development access.
CLAWDIFY_ALLOWED_DEV_ORIGINS=
# Optional project for restart notifications; blank skips notifications.
CLAWDIFY_NOTIFY_PROJECT_ID=
# Optional absolute path if openclaw is not available on PATH.
OPENCLAW_BIN=
